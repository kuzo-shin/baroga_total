{
  // 바로가 공장 ERP — Cloudflare 서버(Worker) 설정
  //  화면(index.html·*.js)과 서버(cloud/src)를 한 주소에서 함께 제공하고, Cloudflare Access 로그인(허용한 구글 계정)으로 전체를 보호
  //  DB 이식 순서: 공장 일지(완료) → 나머지 메뉴(구글 시트 DB)를 차례로. 이식이 끝날 때까지 옛 주소(GitHub Pages)도 함께 둠
  //  이 파일을 저장소 맨 위에 두는 이유: Cloudflare가 저장소 맨 위에서 배포 명령을 돌리기 때문
  //  이름(name)은 Cloudflare에 만든 Worker 이름과 같아야 함
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baroga-total",
  "main": "cloud/src/index.js",
  "compatibility_date": "2026-11-01",
  // 배포 전에 화면 파일만 .site 폴더로 모음 (서버 코드·gas·tools 는 화면으로 내보내지 않음)
  "build": { "command": "rm -rf .site && mkdir .site && cp index.html *.js *.png .site/" },
  "assets": { "directory": "./.site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // 아이디를 적지 않으면 첫 배포 때 Cloudflare가 이 이름으로 자동으로 만들고 계속 연결함 (wrangler 4.45 이상)
  "d1_databases": [{ "binding": "DB", "database_name": "baroga-erp-db" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "baroga-erp-photos" }],
  // 배포할 때 Cloudflare 화면에서 넣은 변수·비밀값을 지우지 않음
  "keep_vars": true,
  "vars": {
    // Cloudflare Access (Worker → Access 탭의 Application values). 서버가 로그인 토큰의 서명·대상을 확인할 때 씀. 비밀값 아님
    "ACCESS_TEAM_DOMAIN": "nameless-band-cc7c.cloudflareaccess.com",
    "ACCESS_AUD": "4247fc17eee4908e07be912968bd9229a54364c155f1e28d99580ae517c92b3e"
  },
  // PR(브랜치)마다 Cloudflare가 만드는 미리보기 서버용 설정. 운영 자료를 건드리지 않도록 시험용 DB·저장소를 따로 씀 (2026-11-27 Cloudflare 화면에서 만듦)
  "previews": {
    "vars": {
      "ACCESS_TEAM_DOMAIN": "nameless-band-cc7c.cloudflareaccess.com",
      "ACCESS_AUD": "4247fc17eee4908e07be912968bd9229a54364c155f1e28d99580ae517c92b3e"
    },
    "d1_databases": [{ "binding": "DB", "database_name": "baroga-erp-db-preview", "database_id": "fdbae274-2936-449e-a3b8-4d399f9a5004" }],
    "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "baroga-erp-photos-preview" }]
  },
  "observability": { "enabled": true }
}
